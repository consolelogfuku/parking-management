<div class="form-card">
  <%= form_with(model: parking, url: url, method: method) do |f| %>
    <% if parking.errors.any? %>
      <div class="form-errors">
        <strong>⚠️ 入力内容にエラーがあります</strong>
        <ul class="form-errors-list">
          <% parking.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :name, "🏷️ 駐車場名" %>
      <%= f.text_field :name %>
    </div>

    <div class="form-group">
      <%= f.label :status, "📊 空き状況" %>
      <%= f.select :status, Parking.status.options %>
    </div>

    <div class="form-group">
      <%= f.label :phone_number, "📞 電話番号" %>
      <%= f.text_field :phone_number, placeholder: "例: 0312345678" %>
    </div>

    <div class="form-actions">
      <%= f.submit submit_label, class: "btn btn-primary" %>
      <%= link_to "← 戻る", manage_parkings_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
