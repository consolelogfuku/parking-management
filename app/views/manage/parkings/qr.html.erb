<h1 class="no-print">📱 <%= @parking.name %> - QRコード</h1>

<div class="qr-container">
  <p class="qr-parking-name"><%= @parking.name %></p>

  <div class="qr-card">
    <% qr = RQRCode::QRCode.new(@public_url) %>
    <%= qr.as_svg(
      color: "000",
      shape_rendering: "crispEdges",
      module_size: 6,
      standalone: true,
      use_path: true
    ).html_safe %>
  </div>

  <p class="qr-url no-print">
    🔗 公開URL: <%= link_to @public_url, @public_url, target: "_blank" %>
  </p>

  <div class="qr-actions no-print">
    <%= link_to "📄 PDFダウンロード", qr_pdf_manage_parking_path(@parking), class: "btn btn-primary" %>
    <%= link_to "← 戻る", manage_parkings_path, class: "btn btn-secondary" %>
  </div>
</div>
