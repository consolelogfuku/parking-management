<div class="form-card">
  <%= form_with(model: admin_user, url: url, method: method) do |f| %>
    <% if admin_user.errors.any? %>
      <div class="form-errors">
        <strong>入力内容にエラーがあります</strong>
        <ul class="form-errors-list">
          <% admin_user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email %>
    </div>

    <div class="form-group">
      <%= f.label :password, "パスワード#{admin_user.persisted? ? '（変更する場合のみ入力）' : ''}" %>
      <%= f.password_field :password %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "パスワード確認" %>
      <%= f.password_field :password_confirmation %>
    </div>

    <div class="form-actions">
      <%= f.submit submit_label, class: "btn btn-primary" %>
      <%= link_to "← 戻る", admin_admin_users_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
