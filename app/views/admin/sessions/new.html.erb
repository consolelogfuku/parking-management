<div class="login-container">
  <div class="login-card">
    <h1>🅿️ Parking Management</h1>
    <p class="subtitle">管理者ログイン</p>

    <%= form_for(resource, as: resource_name, url: admin_user_session_path) do |f| %>
      <div class="login-field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "example@email.com" %>
      </div>

      <div class="login-field">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "パスワードを入力" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="login-remember">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "ログイン状態を保持する" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "ログイン", class: "login-submit" %>
      </div>
    <% end %>

  </div>
</div>
