<h1>ユーザー一覧</h1>

<p class="create-btn-area">
  <%= link_to "新規作成", new_admin_user_path, class: "btn btn-primary" %>
</p>

<div class="admin-table-wrapper">
  <table class="admin-table">
    <thead>
      <tr>
        <th>メールアドレス</th>
        <th>駐車場数</th>
        <th>作成日</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.email %></td>
          <td><%= user.parkings.size %></td>
          <td><%= l user.created_at, format: :short %></td>
          <td class="admin-table-actions">
            <%= link_to "詳細", admin_user_path(user), class: "btn btn-info btn-sm" %>
            <%= link_to "編集", edit_admin_user_path(user), class: "btn btn-secondary btn-sm" %>
            <%= link_to "削除", admin_user_path(user), data: { turbo_method: :delete, turbo_confirm: "「#{user.email}」を削除しますか？関連する駐車場も全て削除されます。" }, class: "btn btn-danger btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
