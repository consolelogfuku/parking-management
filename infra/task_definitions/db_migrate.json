[
  {
    "name": "db-migrate",
    "image": "${repository_url}:latest",
    "command": ["bin/rails", "db:migrate"],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "${awslogs_group}",
        "awslogs-region": "ap-northeast-1",
        "awslogs-stream-prefix": "db-migrate"
      }
    },
    "environment": [
      {
        "name": "RAILS_ENV",
        "value": "production"
      }
    ],
    "secrets": [
      {
        "name": "DATABASE_URL",
        "valueFrom": "/parking-checker/production/DATABASE_URL"
      },
      {
        "name": "RAILS_MASTER_KEY",
        "valueFrom": "/parking-checker/rails/master-key"
      }
    ],
    "essential": true
  }
]
